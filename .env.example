# FENRIR environment configuration

# Engine selection: local or anthropic
ENGINE=local

# Required only when ENGINE=anthropic
ANTHROPIC_API_KEY=

# Optional: increases NVD API rate limit for CVE lookups
NVD_API_KEY=

# Optional: Hugging Face token for local/hosted model integrations
HF_TOKEN=

# Optional: enable verbose debug behavior
DEBUG=false

# Optional: report output directory
REPORT_DIR=result

# ── OPSEC Mode ────────────────────────────────────────────────────────────────
# Set to true for internal scans to reduce detection risk.
# Effects: nmap T1 + 2s scan-delay, gobuster 1-thread + 1s delay,
#          spoofed browser User-Agent on all HTTP tools, inter-request sleep.
OPSEC_MODE=false

# Seconds to sleep between HTTP requests when OPSEC_MODE=true (default 2.0)
OPSEC_DELAY=2.0

# User-Agent string used by all HTTP tools when OPSEC_MODE=true
# OPSEC_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
